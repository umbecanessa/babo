DATABASE_URL=postgresql://nls:nls@localhost:5432/nls
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-me-to-another-random-64-char-string
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
RUNTIME_URL=http://127.0.0.1:9222
RUNTIME_SHARED_SECRET=change-me-shared-secret
PORT=3000
# Email / Resend (Babo Cloud or self-hosted server env)
RESEND_API_KEY=
RESEND_INBOUND_DOMAIN=
# Public HTTPS base for webhook URLs shown in the desktop app (optional)
PUBLIC_API_URL=

# Babo Cloud (set BABO_CLOUD_MODE=false for pure self-host without entitlements)
BABO_CLOUD_MODE=true
SECRETS_ENCRYPTION_KEY=change-me-encryption-key-for-provider-secrets

# Inference relay (Nest → GX10 / vLLM). Clients use /api/inference/v1/*
INFERENCE_UPSTREAM_URL=http://127.0.0.1:8000
INFERENCE_UPSTREAM_API_KEY=
INFERENCE_DEFAULT_RPM=120
NLS_API_KEY_PREFIX=nlsk_

# GPU relay (transcribe / vision / embed) — defaults to INFERENCE host without /v1
GPU_UPSTREAM_URL=
GPU_UPSTREAM_SECRET=
GPU_TRANSCRIBE_UPSTREAM_URL=
GPU_VISION_UPSTREAM_URL=
GPU_EMBED_UPSTREAM_URL=
