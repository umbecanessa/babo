{
  "name": "babo-desktop",
  "version": "1.0.5",
  "description": "Babo Desktop App",
  "author": "Babo",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/umbecanessa/babo.git"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "build:angular": "cd ../frontend && npx ng build --configuration=electron",
    "build:angular:web": "cd ../frontend && npx ng build --configuration=production",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:angular && npm run build:electron",
    "start": "npm run build:electron && electron .",
    "dev:ui": "cd ../frontend && npx ng serve --configuration=electron",
    "start:dev": "npm run build:electron && cross-env NODE_ENV=development electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "~5.6.0"
  }
}
